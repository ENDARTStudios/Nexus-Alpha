# Nexus-Alpha — exemplo de variáveis de ambiente
# Copie para `.env` (que é gitignored) e preencha. NUNCA comite o .env real.

# --- Neo4j AuraDB (obrigatório em produção) ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- API / segurança ---
NEXUS_API_TOKEN=
NEXUS_CORS_ORIGINS=*
NEXUS_CORS_ORIGIN_REGEX=https://.*\.vercel\.app
NEXUS_BOOTSTRAP_SCHEMA=true

# --- Qdrant Cloud (opcional; sem isto usa memória in-process) ---
QDRANT_HOST=
QDRANT_API_KEY=

# --- LLM opcional (endpoint compatível com OpenAI: HF Inference, OpenRouter, Ollama) ---
NEXUS_LLM_BASE_URL=
NEXUS_LLM_MODEL=
NEXUS_LLM_API_KEY=

# --- Frontend (Next.js) ---
# Modo direto (Space PÚBLICO). Deixe vazio para usar o proxy server-side (recomendado).
NEXT_PUBLIC_NEXUS_API_URL=

# --- Proxy server-side (Vercel). NUNCA use prefixo NEXT_PUBLIC_ aqui. ---
NEXUS_SPACE_URL=https://<user>-<space>.hf.space
HF_TOKEN=
NEXUS_API_TOKEN=

# --- Backend opcional de renderização dinâmica (browser-use) ---
OPENAI_API_KEY=
